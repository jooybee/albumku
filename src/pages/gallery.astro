---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery';
import { EVENT_CONFIG } from '../lib/config';
---

<Layout title={`Album — ${EVENT_CONFIG.name}`}>
  <main class="page">
    <header class="header">
      <a href="/" class="back">← Kamera</a>
      <p class="label">Album</p>
      <h1 class="title">{EVENT_CONFIG.name}</h1>
      <p class="sub">Album bersama · momen dari semua tamu</p>
    </header>

    <div class="container">
      <Gallery client:only="react" />
    </div>
  </main>
</Layout>

<style>
  .page {
    min-height: 100dvh;
    padding: 16px 0 48px;
    background: #0a0a0a;
  }
  .header {
    text-align: center;
    margin-bottom: 24px;
    padding: 8px 16px 0;
    position: relative;
  }
  .back {
    position: absolute;
    left: 16px;
    top: 12px;
    font-size: 0.85rem;
    color: #8a8580;
  }
  .label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #5c5854;
    margin-bottom: 4px;
  }
  .title {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.75rem;
    color: #f5f0eb;
    line-height: 1.2;
  }
  .sub {
    font-size: 0.8rem;
    color: #5c5854;
    margin-top: 6px;
  }
</style>
